# {{ ansible_managed }}

[Unit]
Description=Unsloth Studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="PATH={{ unsloth_path }}"
ExecStart=/usr/local/bin/start_unsloth_studio.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target