# {{ ansible_managed }}

[Unit]
Description=Unsloth Studio - %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Environment="PATH={{ unsloth_path }}"
ExecStart=/usr/local/bin/start_unsloth_studio.sh %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target